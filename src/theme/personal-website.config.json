{
  "version": 1,
  "name": "personal-website",
  "extends": "nova",
  "defaults": { "mode": "light", "density": "comfortable" },
  "color": {
    "light": {
      "canvas": "#ffffff",
      "surface": "#ffffff",
      "ink": "#111111",
      "ink-muted": "#70706d",
      "line": "#ececec",
      "brand": "#f04a00",
      "brand-ink": "#ffffff"
    },
    "dark": {
      "canvas": "#0f0f0e",
      "surface": "#0f0f0e",
      "ink": "#f2f2ef",
      "ink-muted": "#8f8f8a",
      "line": "#262624",
      "brand": "#f04a00",
      "brand-ink": "#ffffff"
    }
  },
  "shape": {
    "radius": "0.625rem",
    "shape-item": "0.5rem",
    "shape-control": "0.75rem",
    "shape-floating": "0.625rem",
    "shape-container": "0.875rem"
  },
  "type": {
    "typeface-sans": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, sans-serif",
    "typeface-heading": "\"Geist\", ui-sans-serif, system-ui, sans-serif",
    "typeface-mono": "ui-monospace, \"SFMono-Regular\", Menlo, monospace",
    "type-caption": "0.75rem",
    "type-caption-leading": "1.4",
    "type-body": "1rem",
    "type-body-leading": "1.65",
    "type-title": "1.125rem",
    "type-title-leading": "1.5",
    "type-heading": "1.375rem",
    "type-heading-leading": "1.25",
    "type-display": "1.75rem",
    "type-display-leading": "1.2"
  },
  "elevation": {
    "elevation-raised": "0 1px 2px rgba(17, 17, 17, 0.04)",
    "elevation-floating": "0 8px 24px rgba(17, 17, 17, 0.06)",
    "elevation-modal": "0 24px 60px -12px rgba(17, 17, 17, 0.25)"
  }
}
